{
  "name": "rayz-mobile",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev:mock": "pnpm --filter @rayz/mock-api start",
    "dev:customer": "pnpm --filter @rayz/customer web",
    "dev:staff": "pnpm --filter @rayz/staff web",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "generate:api": "pnpm --filter @rayz/api generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "query-string": "7.1.3"
  }
}
