# --- Database (local Postgres, Neon, or Supabase) ---
DATABASE_URL=postgres://rayz:rayz@localhost:5432/rayz
# Direct (unpooled) connection for migrations; the Vercel Neon integration sets DATABASE_URL_UNPOOLED. Optional.
# MIGRATE_DATABASE_URL=
# Used by `pnpm test:db` (integration tests run against a throwaway database)
TEST_DATABASE_URL=postgres://rayz:rayz@localhost:5432/rayz_test

# --- Auth ---
# 32+ random chars. Signs staff session cookies and customer API access tokens.
AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# When true, OTP codes are returned in the API response in `pnpm dev` only. Ignored in any production build.
AUTH_DEV_CODES=true

# --- Launch ---
# One UTC instant for the website, the iOS and Android customer apps, and customer-facing payments and push.
# Overrides brand_settings.launch_at. Leave unset (and the column null) to keep customer booking closed.
# LAUNCH_AT=2026-11-01T14:00:00.000Z

# --- Stripe (test mode). Leave blank to use the built-in payment simulator. ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect: the signing secret of the webhook for events on connected accounts (/api/stripe/connect).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Processing fee passed on to each shop's account as the application fee. Defaults: 2.9%+30 keyed, 2.7%+5 on the reader.
CONNECT_FEE_KEYED=
CONNECT_FEE_TERMINAL=

# --- Twilio Verify (test credentials only). Leave unset to keep the local OTP code. ---
# `pnpm smoke:v1` GETs the Verify service when all three are set. It never texts a real number.
# Set TWILIO_SMOKE_TO=+15005550006 to also start a Verify check against Twilio's magic test number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_SMOKE_TO=

# --- Notifications (off by default) ---
# disabled | console | twilio | resend   (twilio/resend are stubs in v1)
NOTIFICATIONS_SMS_PROVIDER=disabled
NOTIFICATIONS_EMAIL_PROVIDER=disabled
# Shared secret for the cron endpoint that drains the reminder queue. Required: the endpoint refuses all calls without it.
CRON_SECRET=change-me

# Public base URL used in links inside notifications
APP_BASE_URL=http://localhost:3000

# --- Hosted demo preview (see DEPLOY.md). Never on a deployment with real clients. ---
# true: payment simulator (or Stripe test keys only), no texts/emails/calls, sign-in codes on screen, demo logins on /login,
# and `pnpm vercel-build` loads the sample data into an empty database.
DEMO_MODE=false
# true: reload the sample data on the next deploy (wipes the database). Remove it afterwards.
# DEMO_RESEED=
# Password for every seeded login (default rayz2026!). When set, /login doesn't show it.
# SEED_PASSWORD=
# true: the build doesn't touch the database (run `pnpm db:migrate` yourself).
# SKIP_DB_MIGRATE=
