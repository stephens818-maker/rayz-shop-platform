# --- Database (local Postgres, Neon, or Supabase) ---
DATABASE_URL=postgres://rayz:rayz@localhost:5432/rayz
# Direct (unpooled) connection for migrations; the Vercel Neon integration sets DATABASE_URL_UNPOOLED. Optional.
# MIGRATE_DATABASE_URL=
# Used by `pnpm test:db` (integration tests run against a throwaway database)
TEST_DATABASE_URL=postgres://rayz:rayz@localhost:5432/rayz_test

# --- Auth ---
# 32+ random chars. Signs staff session cookies and customer API access tokens.
AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# When true, OTP codes are returned in the API response in `pnpm dev` only. Ignored in any production build.
AUTH_DEV_CODES=true
# Self-hosted only: how many proxies in front of the app append to x-forwarded-for. The client IP (for
# sign-in restrictions and the time clock's network check) is that many entries from the end. Unset
# off Vercel means the IP is unknown and shops that limit sign-in to their network refuse requests.
# TRUSTED_PROXY_HOPS=1

# --- Stripe (test mode). Leave blank to use the built-in payment simulator. ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect: the signing secret of the webhook for events on connected accounts (/api/stripe/connect).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Processing fee passed on to each shop's account as the application fee. Defaults: 2.9%+30 keyed, 2.7%+5 on the reader.
CONNECT_FEE_KEYED=
CONNECT_FEE_TERMINAL=
# Tip payouts to employees' Express accounts (transfers and payouts) run in Stripe test mode only. true allows them with
# a live key; leave it off until Charles signs off.
# MONEY_MOVEMENT_LIVE=
# ON HOLD (ST-C7): direct Stripe tip payouts to each employee's own Express account. Ray'z staff are W-2 employees whose
# tips may need payroll withholding; off (the default) pays every tip through payroll (the iSolved export) or cash.
# FEATURE_STAFF_STRIPE_PAYOUTS=
# Staff app (ST-I8): minimum and latest builds (older gets 426 upgrade_required), store links, a maintenance notice,
# switching the app's time clock off, Tap to Pay (needs Apple's entitlement and each shop's Terminal location), support.
# STAFF_APP_IOS_MIN_VERSION=
# STAFF_APP_IOS_LATEST_VERSION=
# STAFF_APP_IOS_STORE_URL=
# STAFF_APP_ANDROID_MIN_VERSION=
# STAFF_APP_ANDROID_LATEST_VERSION=
# STAFF_APP_ANDROID_STORE_URL=
# STAFF_APP_MAINTENANCE_MESSAGE=
# STAFF_APP_CLOCK_OFF=
# FEATURE_STAFF_TAP_TO_PAY=
# STAFF_APP_SUPPORT_EMAIL=
# STAFF_APP_SUPPORT_PHONE=
# Paying in the app (I10, NOT DECIDED): on_behalf_of (default) charges on the platform for the shop's account; destination
# makes destination charges. Saved cards live on a platform-level Stripe Customer either way.
# STRIPE_CHARGE_MODEL=on_behalf_of
# true only once Stripe has confirmed the surcharge field for the account: the card fee is sent as Stripe's surcharge amount.
# STRIPE_SURCHARGE_FIELD=
# NOT DECIDED: true also adds the card fee to credit cards paid with Apple Pay or Google Pay. Off by default.
# FEATURE_WALLET_FEE=
# Apple Pay in the app's payment sheet (merchant.com.…) and the name shown on it (default Ray'z Barber Shop).
# APPLE_PAY_MERCHANT_ID=
# STRIPE_MERCHANT_DISPLAY_NAME=

# --- Bot check on signed-out website booking (Cloudflare Turnstile). Off until both are set. ---
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Notifications (off by default) ---
# Texts and calls: disabled | console | simulator | twilio. simulator feeds Notifications -> Call and text simulator.
# twilio without TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN behaves like disabled.
NOTIFICATIONS_SMS_PROVIDER=disabled
NOTIFICATIONS_VOICE_PROVIDER=disabled
# Email: disabled | console | resend | postmark. resend and postmark send for real once their key is set.
NOTIFICATIONS_EMAIL_PROVIDER=disabled
# The sender, on a domain verified with the provider.
EMAIL_FROM=
RESEND_API_KEY=
# Resend webhook signing secret (whsec_...), for /api/email/resend: delivered, bounced, complained.
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
# Postmark webhook basic credentials "user:password", for /api/email/postmark.
POSTMARK_WEBHOOK_AUTH=
# App push (appointments and, with consent, marketing): disabled | console | simulator | native | expo (expo is a stub).
# native sends straight to Apple (APNs) and Google (FCM) with the keys below; either half can be left empty.
NOTIFICATIONS_PUSH_PROVIDER=disabled
# APNs token auth: the .p8 key's ID, the Apple team ID, the key itself (PEM, \n for newlines) and the app's bundle ID.
# APNS_ENVIRONMENT=production for TestFlight and App Store builds; anything else uses Apple's sandbox.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox
# The staff app (/api/staff/v1): its iOS bundle ID for pushes to staff phones (the same .p8 key signs; the customer
# app's bundle ID when empty), and its URL scheme, which Stripe's payout setup returns to (rayzstaff when empty).
STAFF_APNS_BUNDLE_ID=
STAFF_APP_SCHEME=
# FCM HTTP v1: the Firebase service account JSON on one line (or FCM_PROJECT_ID, FCM_CLIENT_EMAIL and FCM_PRIVATE_KEY).
FCM_SERVICE_ACCOUNT_JSON=
# Twilio. Texts go from the shop's own Twilio number (Shop settings), else the messaging service, else TWILIO_FROM.
# Calls use the shop's number, else TWILIO_FROM. Webhooks are verified with the auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# The Messaging Service on the brand's separate 10DLC marketing campaign. Campaign Center and open-chair texts go through it;
# unset, they go from the shop's number like appointment texts. Point its inbound webhook at /api/twilio/sms too.
TWILIO_MARKETING_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# 1 when Twilio Advanced Opt-Out answers HELP (the Messaging Service has the brand's HELP text); otherwise the app replies.
# TWILIO_ADVANCED_OPT_OUT=1
# Shared secret for the cron endpoint that drains the reminder queue. Required: the endpoint refuses all calls without it.
CRON_SECRET=change-me

# Public base URL used in links inside notifications
APP_BASE_URL=http://localhost:3000

# Address autocomplete and map pins for location profiles (src/server/geo.ts). With a Google Maps key (Places API (New) and
# Geocoding API enabled, restricted to this server), suggestions come from Google and fill in the Place ID. Without one,
# GEOCODER=census uses the free US Census geocoder; otherwise the pin is the ZIP's centre (marked approximate). Server-side only.
# GOOGLE_MAPS_API_KEY=
# GEOCODER=census

# --- Hosted demo preview (see DEPLOY.md). Never on a deployment with real clients. ---
# true: payment simulator (or Stripe test keys only), no texts/emails/calls, sign-in codes on screen, demo logins on /login,
# and `pnpm vercel-build` loads the sample data into an empty database. The build and the server refuse to start with it
# when APP_ENV=production, a live Stripe key, or a real NOTIFICATIONS_* provider is set (src/lib/deployment.ts).
DEMO_MODE=false
# Set to production on a deployment with real clients (DEPLOY.md). It makes DEMO_MODE=true stop the build and the server.
# APP_ENV=
# Other browser origins allowed to call /api/v1 (comma-separated, e.g. the brand website). The app's own origin
# (APP_BASE_URL) is always allowed, and localhost in development. The mobile apps send no Origin and aren't affected.
# CORS_ORIGINS=https://rayzbarbershop.com
# true: reload the sample data on the next deploy (wipes the database). Remove it afterwards.
# DEMO_RESEED=
# Password for every seeded login (default rayz2026!). When set, /login doesn't show it.
# SEED_PASSWORD=
# true: the build doesn't touch the database (run `pnpm db:migrate` yourself).
# SKIP_DB_MIGRATE=

# --- Customer app (src/server/app-config.ts). All optional; GET /api/v1/app/config reports them. ---
# Builds below the minimum get 426 upgrade_required on every /api/v1 route but /app/config (they send X-Client and X-App-Version).
# APP_IOS_MIN_VERSION=
# APP_IOS_LATEST_VERSION=
# APP_IOS_STORE_URL=
# APP_ANDROID_MIN_VERSION=
# APP_ANDROID_LATEST_VERSION=
# APP_ANDROID_STORE_URL=
# A notice the app shows at launch while set.
# APP_MAINTENANCE_MESSAGE=
# APP_SUPPORT_EMAIL=
# APP_SUPPORT_PHONE=
# APP_PRIVACY_URL=
# APP_TERMS_URL=
# Kill switches, for an outage when Setup → App switches can't be reached: comma-separated, any of booking,payments,family,pushMarketing.
# APP_KILL=
# Sign-in codes by text. local (default): made here and sent through NOTIFICATIONS_SMS_PROVIDER. twilio_verify: Twilio Verify
# sends and checks them (no 10DLC registration needed for codes; turn Fraud Guard on in the Verify service). Uses the
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above. Email codes always use the email provider.
# OTP_SMS_PROVIDER=twilio_verify
# TWILIO_VERIFY_SERVICE_SID=VA...
# App Review sign-in (C18, NOT APPROVED, off): with FEATURE_REVIEW_LOGIN=true, APP_REVIEW_PHONE signs in with the fixed
# 6-digit APP_REVIEW_CODE (nothing is texted) onto a sandbox "App Review" profile; every use is audit-logged. Its bookings
# stay at APP_REVIEW_SHOP (a shop slug) and notify nobody; it can't pay with live Stripe keys. APP_REVIEW_EMAIL is an
# optional monitored inbox for an emailed code. Leave all of it unset until the owner approves.
# FEATURE_REVIEW_LOGIN=
# APP_REVIEW_PHONE=
# APP_REVIEW_CODE=
# APP_REVIEW_EMAIL=
# APP_REVIEW_SHOP=
# Universal links and Android App Links: /.well-known/apple-app-site-association and /.well-known/assetlinks.json answer 404 until set.
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=
# ANDROID_PACKAGE=
# Comma-separated SHA-256 fingerprints of the app signing certificates (Play Console → App integrity).
# ANDROID_CERT_SHA256=
