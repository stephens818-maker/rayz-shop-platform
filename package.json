{
  "name": "rayz-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/deploy-db.ts && next build",
    "db:deploy": "tsx scripts/deploy-db.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/db/**\" --exclude \"tests/perf/**\"",
    "test:db": "vitest run tests/db",
    "test:perf": "vitest run tests/perf",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-scale": "tsx scripts/seed-scale.ts",
    "rollups:backfill": "tsx --require ./scripts/allow-server-only.cjs scripts/rollups-backfill.ts",
    "analytics:backfill": "tsx --require ./scripts/allow-server-only.cjs scripts/analytics-backfill.ts",
    "db:reset": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "worker": "tsx --require ./scripts/allow-server-only.cjs scripts/worker.ts",
    "import:squire": "tsx scripts/import-squire.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.13",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.2",
    "next": "15.5.28",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
